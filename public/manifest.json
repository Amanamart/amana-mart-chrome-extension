{
  "manifest_version": 3,
  "name": "AmanaMart Quick Assistant",
  "version": "1.0.0",
  "description": "Quick search, image search, and order tracking for AmanaMart.",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://api.amanamart.com/*"
  ]
}
